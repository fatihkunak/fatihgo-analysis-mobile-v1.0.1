# Kopyala: .env  (gerçek değerler git'e girmez)
PORT=3102
HOST=127.0.0.1
# Migrasyonlar için sahip rolü (yalnızca `npm run migrate` ve testler kullanır)
OWNER_DATABASE_URL=postgres://nichevo_owner:CHANGE_ME@127.0.0.1:5545/nichevo
# Çalışma zamanı rolü: yalnızca tablo yetkileri var, süper kullanıcı değil
DATABASE_URL=postgres://nichevo_app:CHANGE_ME@127.0.0.1:5545/nichevo
APP_DB_PASSWORD=CHANGE_ME
# En az 32 karakter; erişim jetonlarını imzalar
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# İsteğe bağlı: Google ile giriş. Console'da "Web uygulaması" türünde OAuth istemcisi oluştur ve
# yetkili yönlendirme URI'si olarak <PUBLIC_URL>/v1/auth/google/callback adresini ekle.
# İkisi de boşsa Google düğmesi uygulamada görünmez.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_URL=https://nichevo-api.fatihgo.com
